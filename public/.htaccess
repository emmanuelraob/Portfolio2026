# SPA routing for Vite/React on Apache
RewriteEngine On
RewriteBase /

# Allow the actual files to be served directly
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Fallback to index.html so client router handles the route
RewriteRule . /index.html [L]
